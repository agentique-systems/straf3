# Copy to the repository root as `.env`, which is gitignored, and fill in the
# real values. This file is the shape only — it contains no credential and
# never will.
#
#     cp tools/straf3-webcheck/env.example .env
#
# `.env` does not follow a git worktree, because git does not copy ignored
# files. Working in one? Copy it across from the main checkout.
#
# `tools/straf3-webcheck/ecosystem.sh` reads this file as DATA — it does not
# source it — so a backtick or a `$(` in a password is a character rather than
# a command. Values may be quoted or bare.

# ── the one origin ──────────────────────────────────────────────────────────
# Everything a browser touches is under this. The site serves it; the records
# service is behind it and is never addressed by a page.
STRAF3_ORIGIN=http://localhost:8787

# ── Postgres ────────────────────────────────────────────────────────────────
# The pooled Neon connection string. `sqlx` reads it from the environment, so
# it is never a command-line argument and never reaches a process title.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# ── Neon Auth (Better Auth) ─────────────────────────────────────────────────
# This supersedes docs/web/ARCHITECTURE.md §6 in its entirety: nobody
# implements OAuth providers, session cookies or CSRF machinery. The site signs
# in against the base URL and holds the JWT; the service verifies it against
# the JWKS.
#
# Note the tokens are Ed25519 (EdDSA), not RS256 — a verifier that assumes
# RS256 fails late, inside the auth path, where it is hardest to read.
NEON_AUTH_BASE_URL=https://api.stack-auth.com/api/v1/projects/PROJECT_ID
NEON_AUTH_JWKS_URL=https://api.stack-auth.com/api/v1/projects/PROJECT_ID/.well-known/jwks.json
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# ── optional overrides ──────────────────────────────────────────────────────
# Where the records service binds. It is never addressed by a page; the site
# proxies /v1/* to it.
#STRAF3_RECORDS_ADDR=127.0.0.1:8788
